# Console Gateway Environment Variables
# Copy to .env and fill in values

# Console専用Supabase (Trading ViewのSupabaseとは別プロジェクト)
SUPABASE_URL=https://your-console-project.supabase.co
SUPABASE_SERVICE_KEY=your-console-service-role-key

# Console Gateway認証シークレット (Admin MT5 DataManagerと同じ値を設定)
CONSOLE_GATEWAY_SECRET=your-console-gateway-secret
MT5_GATEWAY_SECRET=your-console-gateway-secret

# Gateway起動ポート
MT5_WEBSOCKET_PORT=8081
PORT=8081

# Supabaseバッチ設定 (オプション)
SUPABASE_BATCH_SIZE=500
SUPABASE_BATCH_DELAY_MS=50
