# ==================================================
# AVLFX Console — Environment Variables
# ==================================================
#
# このファイルは .env.example です。
# 実際の値を .env.local にコピーして設定してください。
#   cp .env.example .env.local
#
# IMPORTANT:
#   - .env.local は絶対に Git にコミットしないこと
#   - ConsoleはTrading ViewのENVを共有しない
#   - Console専用Supabaseを使用すること
# ==================================================


# ==================================================
# Supabase (Console専用 — Trading ViewのSupabaseと別プロジェクト)
# ==================================================

# Console専用Supabaseプロジェクト URL
NEXT_PUBLIC_SUPABASE_URL=https://your-console-project.supabase.co

# Console専用 Publishable Key (Anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-console-publishable-key

# Console専用 Service Role Key (Server-sideのみ / bar_data書き込み等)
SUPABASE_SERVICE_ROLE_KEY=your-console-service-role-key


# ==================================================
# Console Gateway (Console専用Gateway — Trading GatewayとURL別)
# ==================================================

# Console GatewayのURL (Railway等でデプロイしたConsole専用ゲートウェイ)
CONSOLE_GATEWAY_URL=https://your-console-gateway.up.railway.app

# Console Gateway認証シークレット
CONSOLE_GATEWAY_SECRET=your-console-gateway-secret

# Next.jsサーバーサイドからGatewayへのURL (上記と同値でよい)
MT5_GATEWAY_URL=https://your-console-gateway.up.railway.app

# Gateway認証シークレット (CONSOLE_GATEWAY_SECRETと同値でよい)
MT5_GATEWAY_SECRET=your-console-gateway-secret

# ローカル開発時のGatewayポート
MT5_WEBSOCKET_PORT=8081


# ==================================================
# Console Admin Access
# ==================================================

# Admin許可メールアドレス (カンマ区切り)
# 例: admin@example.com,ops@example.com
ADMIN_EMAILS=


# ==================================================
# Application
# ==================================================

NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001
NODE_ENV=development


# ==================================================
# AI (オプション — Console側AI機能を使う場合)
# ==================================================

# OPENAI_API_KEY=sk-your-openai-api-key
